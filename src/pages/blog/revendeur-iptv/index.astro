---
import SiteLayout from "../../../layouts/SiteLayout.astro";

const posts = [
  {
    href: "/blog/comment-choisir-un-fournisseur-iptv-grossiste-fiable",
    title: "Comment choisir un fournisseur IPTV grossiste fiable ?",
    excerpt: "Les 7 critères concrets à vérifier avant d'engager une relation commerciale et les drapeaux rouges qui doivent vous faire fuir.",
  },
];
---

<SiteLayout
  title="Articles Revendeur IPTV — Blog Grossiste IPTV"
  description="Articles dédiés aux revendeurs IPTV : choisir un fournisseur fiable, démarrer son activité, gérer ses clients en autonomie."
  canonical="https://grossisteiptv.com/blog/revendeur-iptv/"
>

  <section class="max-w-4xl mx-auto px-6 pt-20 lg:pt-28 pb-8 reveal">
    <p class="text-xs font-bold text-emerald-400 uppercase tracking-widest mb-4"><a href="/blog" class="hover:underline">Blog</a> / Revendeur IPTV</p>
    <h1 class="text-4xl md:text-5xl font-extrabold leading-[1.1] tracking-tight mb-4">Articles : <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">Revendeur IPTV</span></h1>
    <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">Tout pour démarrer, gérer et faire croître votre activité de revendeur IPTV : choix du fournisseur, gestion clients, conformité, marges.</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-8 pb-20 reveal">
    <div class="space-y-4">
      {posts.map((p) => (
        <a href={p.href} class="block bg-[#0f1420] border border-white/5 hover:border-emerald-500/20 rounded-2xl p-7 transition-all group">
          <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-emerald-400 transition-colors">{p.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed">{p.excerpt}</p>
        </a>
      ))}
    </div>
  </section>

</SiteLayout>
