---
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts = [
  {
    href: "/blog/comment-choisir-un-fournisseur-iptv-grossiste-fiable",
    cat: "Revendeur IPTV",
    catHref: "/blog/revendeur-iptv",
    title: "Comment choisir un fournisseur IPTV grossiste fiable ?",
    excerpt: "Les 7 critères concrets à vérifier avant d'engager une relation commerciale avec un fournisseur en gros, et les drapeaux rouges qui doivent vous faire fuir.",
    catColor: "text-emerald-400",
  },
  {
    href: "/blog/panel-iptv-revendeur-fonctionnalites-indispensables",
    cat: "Panel IPTV",
    catHref: "/blog/panel-iptv",
    title: "Panel IPTV revendeur : les 10 fonctionnalités indispensables",
    excerpt: "Codes test, sous-revendeurs, statistiques, suspension à distance — la checklist des fonctions sans lesquelles un panel ne mérite pas d'être utilisé en production.",
    catColor: "text-indigo-400",
  },
  {
    href: "/blog/credits-iptv-comment-calculer-sa-marge-revendeur",
    cat: "Crédits IPTV",
    catHref: "/blog/credits-iptv",
    title: "Crédits IPTV : comment calculer sa marge revendeur ?",
    excerpt: "Méthode chiffrée pour calculer votre marge brute par client, votre point mort et votre rentabilité par palier de volume. Tableau Excel inclus.",
    catColor: "text-amber-400",
  },
];
---

<SiteLayout
  title="Blog Grossiste IPTV : Conseils Revendeur, Panel & Marges"
  description="Conseils pratiques pour les revendeurs IPTV : choisir son fournisseur, maîtriser son panel, calculer sa marge. Articles longs, chiffrés, sans bullshit marketing."
  canonical="https://grossisteiptv.com/blog/"
>

  <section class="max-w-4xl mx-auto px-6 pt-20 lg:pt-28 pb-12 text-center reveal">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold tracking-wide uppercase mb-6">Blog</div>
    <h1 class="text-4xl md:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight mb-6">
      Le Blog des <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">Revendeurs IPTV</span>
    </h1>
    <p class="text-lg text-slate-400 leading-relaxed max-w-2xl mx-auto">
      Articles longs, chiffrés et sans bullshit marketing. Conseils pratiques pour démarrer, gérer et faire croître une activité de revendeur IPTV professionnel.
    </p>
  </section>

  {/* CATEGORIES */}
  <section class="max-w-5xl mx-auto px-6 py-12 reveal">
    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-5">Catégories</h2>
    <div class="grid md:grid-cols-3 gap-4">
      <a href="/blog/revendeur-iptv" class="bg-[#0f1420] border border-white/5 hover:border-emerald-500/30 rounded-2xl p-6 transition-all group">
        <div class="text-2xl mb-3">🚀</div>
        <h3 class="font-bold mb-1 group-hover:text-emerald-400">Revendeur IPTV</h3>
        <p class="text-slate-400 text-sm">Choisir un fournisseur, démarrer son activité, gérer ses clients.</p>
      </a>
      <a href="/blog/panel-iptv" class="bg-[#0f1420] border border-white/5 hover:border-indigo-500/30 rounded-2xl p-6 transition-all group">
        <div class="text-2xl mb-3">🖥️</div>
        <h3 class="font-bold mb-1 group-hover:text-indigo-400">Panel IPTV</h3>
        <p class="text-slate-400 text-sm">Maîtriser Xtream UI, configurer ses lignes clients, utiliser les codes test.</p>
      </a>
      <a href="/blog/credits-iptv" class="bg-[#0f1420] border border-white/5 hover:border-amber-500/30 rounded-2xl p-6 transition-all group">
        <div class="text-2xl mb-3">💳</div>
        <h3 class="font-bold mb-1 group-hover:text-amber-400">Crédits IPTV</h3>
        <p class="text-slate-400 text-sm">Tarification, paliers de volume, calcul de marge, optimisation rentabilité.</p>
      </a>
    </div>
  </section>

  {/* POSTS */}
  <section class="max-w-5xl mx-auto px-6 py-12 reveal">
    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-5">Articles récents</h2>
    <div class="space-y-4">
      {posts.map((p) => (
        <a href={p.href} class="block bg-[#0f1420] border border-white/5 hover:border-white/15 rounded-2xl p-7 transition-all group">
          <a href={p.catHref} class={`inline-block text-[10px] font-bold uppercase tracking-wider mb-2 ${p.catColor}`}>{p.cat}</a>
          <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-white transition-colors">{p.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed">{p.excerpt}</p>
          <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-300 mt-4">
            Lire l'article
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-24 reveal">
    <p class="text-slate-400 text-sm leading-relaxed text-center">
      Pour tester nos services en direct, demandez un <a href="https://wa.me/212782389820" target="_blank" rel="noopener noreferrer nofollow" class="text-emerald-400 hover:text-emerald-300" onclick="typeof gtag === 'function' && gtag('event', 'generate_lead', { event_category: 'whatsapp_contact', event_label: 'content_cta' });">accès test 24h gratuit</a> ou consultez notre page <a href="/revendeur-iptv" class="text-indigo-400 hover:text-indigo-300">programme revendeur</a>.
    </p>
  </section>

</SiteLayout>
