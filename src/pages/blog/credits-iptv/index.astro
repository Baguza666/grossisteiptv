---
import SiteLayout from "../../../layouts/SiteLayout.astro";

const posts = [
  {
    href: "/blog/credits-iptv-comment-calculer-sa-marge-revendeur",
    title: "Crédits IPTV : comment calculer sa marge revendeur ?",
    excerpt: "Méthode chiffrée pour calculer votre marge brute par client, votre point mort et votre rentabilité par palier de volume.",
  },
];
---

<SiteLayout
  title="Articles Crédits IPTV — Blog Grossiste IPTV"
  description="Articles dédiés aux crédits IPTV en gros : tarification dégressive, paliers de volume, calcul de marge revendeur, optimisation rentabilité."
  canonical="https://grossisteiptv.com/blog/credits-iptv/"
>

  <section class="max-w-4xl mx-auto px-6 pt-20 lg:pt-28 pb-8 reveal">
    <p class="text-xs font-bold text-amber-400 uppercase tracking-widest mb-4"><a href="/blog" class="hover:underline">Blog</a> / Crédits IPTV</p>
    <h1 class="text-4xl md:text-5xl font-extrabold leading-[1.1] tracking-tight mb-4">Articles : <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-rose-400">Crédits IPTV</span></h1>
    <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">Comprendre la mécanique des crédits IPTV en gros : tarification dégressive, paliers de volume, calcul de marge brute, optimisation rentabilité.</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-8 pb-20 reveal">
    <div class="space-y-4">
      {posts.map((p) => (
        <a href={p.href} class="block bg-[#0f1420] border border-white/5 hover:border-amber-500/20 rounded-2xl p-7 transition-all group">
          <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-amber-400 transition-colors">{p.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed">{p.excerpt}</p>
        </a>
      ))}
    </div>
  </section>

</SiteLayout>
