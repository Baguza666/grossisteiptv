---
import SiteLayout from "../../../layouts/SiteLayout.astro";

const posts = [
  {
    href: "/blog/panel-iptv-revendeur-fonctionnalites-indispensables",
    title: "Panel IPTV revendeur : les 10 fonctionnalités indispensables",
    excerpt: "Codes test, sous-revendeurs, statistiques, suspension à distance — la checklist des fonctions sans lesquelles un panel ne mérite pas d'être utilisé.",
  },
];
---

<SiteLayout
  title="Articles Panel IPTV — Blog Grossiste IPTV"
  description="Articles dédiés aux panels IPTV revendeur : Xtream UI, fonctionnalités, gestion de lignes clients, codes test, sous-revendeurs."
  canonical="https://grossisteiptv.com/blog/panel-iptv/"
>

  <section class="max-w-4xl mx-auto px-6 pt-20 lg:pt-28 pb-8 reveal">
    <p class="text-xs font-bold text-indigo-400 uppercase tracking-widest mb-4"><a href="/blog" class="hover:underline">Blog</a> / Panel IPTV</p>
    <h1 class="text-4xl md:text-5xl font-extrabold leading-[1.1] tracking-tight mb-4">Articles : <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Panel IPTV</span></h1>
    <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">Maîtriser votre panel revendeur Xtream UI : fonctionnalités essentielles, configuration, automation, optimisation de la gestion clients.</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-8 pb-20 reveal">
    <div class="space-y-4">
      {posts.map((p) => (
        <a href={p.href} class="block bg-[#0f1420] border border-white/5 hover:border-indigo-500/20 rounded-2xl p-7 transition-all group">
          <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-indigo-400 transition-colors">{p.title}</h3>
          <p class="text-slate-400 text-sm leading-relaxed">{p.excerpt}</p>
        </a>
      ))}
    </div>
  </section>

</SiteLayout>
