    <script>
      function reveal() {
        const reveals = document.querySelectorAll(".reveal");
        for (const el of reveals) {
          const top = el.getBoundingClientRect().top;
          if (top < window.innerHeight - 50) el.classList.add("active");
        }
      }
      window.addEventListener("scroll", reveal);
      reveal();
    </script>

    <div id="mobile-menu" class="md:hidden fixed inset-0 z-[60] pointer-events-none">
      <div id="mobile-backdrop" class="absolute inset-0 bg-black/70 opacity-0 transition-opacity duration-300"></div>
