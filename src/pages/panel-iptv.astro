          </div>
          <div>
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Solutions</h4>
            <ul class="space-y-2">
              <li><a href="/revendeur-iptv" class="text-xs text-slate-400 hover:text-indigo-400">Programme Revendeur</a></li>
              <li><a href="/panel-iptv" class="text-xs text-slate-400 hover:text-indigo-400">Panel IPTV</a></li>
