            </ul>
          </div>
          <div>
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Ressources</h4>
            <ul class="space-y-2">
              <li><a href="/blog" class="text-xs text-slate-400 hover:text-indigo-400">Blog</a></li>
              <li><a href="/faq" class="text-xs text-slate-400 hover:text-indigo-400">FAQ</a></li>
