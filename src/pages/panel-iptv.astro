              <li><a href="/comment-devenir-revendeur-iptv" class="text-xs text-slate-400 hover:text-indigo-400">Devenir Revendeur</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Entreprise</h4>
            <ul class="space-y-2">
              <li><a href="/contact" class="text-xs text-slate-400 hover:text-indigo-400">Contact</a></li>
