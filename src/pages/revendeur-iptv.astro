---
import "../styles/global.css";
import WhatsAppIcon from "../components/icons/WhatsAppIcon.astro";
---

<html lang="fr">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J0C0H0WXR9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-J0C0H0WXR9');
    </script>
    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wpzq3c0mnu");
    </script>
    <!-- WhatsApp CTA → Clarity event -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var a = e.target && e.target.closest && e.target.closest('a[href*="wa.me"]');
        if (a && window.clarity) window.clarity('event', 'whatsapp_click');
      }, { capture: true });
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>Revendeur IPTV : Devenez Partenaire & Achetez en Gros</title>
    <meta name="description" content="Devenez revendeur IPTV partenaire — panel pro, crédits en gros, 7 serveurs élite, support B2B dédié. Marges 100%, gestion autonome, démarrage en 24h. Devis WhatsApp." />
    <link rel="canonical" href="https://grossisteiptv.com/revendeur-iptv/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://grossisteiptv.com/revendeur-iptv/" />
    <meta property="og:title" content="Revendeur IPTV : Devenez Partenaire & Achetez en Gros" />
    <meta property="og:description" content="Devenez revendeur IPTV partenaire — panel pro, crédits en gros, 7 serveurs élite, support B2B dédié. Marges 100%, gestion autonome." />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content="https://grossisteiptv.com/grossisteiptvlogo.png" />
    <meta property="og:image:width" content="519" />
    <meta property="og:image:height" content="69" />
    <meta property="og:image:alt" content="Grossiste IPTV — Revendeur IPTV partenaire" />
    <meta property="og:site_name" content="Grossiste IPTV" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Revendeur IPTV : Devenez Partenaire & Achetez en Gros" />
    <meta name="twitter:description" content="Panel revendeur, crédits en gros, support B2B dédié. Marges 100%, gestion autonome, démarrage en 24h." />
    <meta name="twitter:image" content="https://grossisteiptv.com/grossisteiptvlogo.png" />
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Programme Revendeur IPTV",
      "provider": {"@type": "Organization", "name": "GrossisteIPTV", "url": "https://grossisteiptv.com"},
      "description": "Programme partenaire revendeur IPTV : panel B2B, crédits en gros, accompagnement et support technique pour professionnels en France et Europe.",
      "areaServed": "FR",
      "audience": {"@type": "Audience", "audienceType": "Revendeurs IPTV professionnels"},
      "serviceType": "Programme partenaire B2B"
    }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" /></noscript>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-[#0B0F19] text-white antialiased min-h-screen flex flex-col relative overflow-x-hidden" style="font-family: 'Inter', sans-serif;">

    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute top-[-20%] left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-indigo-600/15 blur-[150px] rounded-full"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[400px] bg-emerald-600/8 blur-[120px] rounded-full"></div>
    </div>

    <header class="sticky top-0 z-50 w-full border-b border-white/5 bg-[#0B0F19]/60 backdrop-blur-2xl">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="text-xl font-black tracking-tighter text-white" aria-label="Accueil Grossiste IPTV"><img src="/grossisteiptvlogo.png" alt="Grossiste IPTV" width="519" height="69" class="h-7 w-auto" />
        </a>
        <nav class="hidden md:flex items-center gap-8 text-[13px] font-medium text-slate-400">
          <a href="/" class="hover:text-white transition-colors duration-200">Accueil</a>
          <a href="/serveurs" class="hover:text-white transition-colors duration-200">Serveurs</a>
          <a href="/services" class="hover:text-white transition-colors duration-200">Services</a>
          <a href="/tarifs-grossiste-iptv" class="hover:text-white transition-colors duration-200">Tarifs</a>
          <a href="/revendeur-iptv" class="text-white">Revendeur</a>
          <a href="/contact" class="hover:text-white transition-colors duration-200">Contact</a>
        </nav>
        <a href="https://wa.me/212782389820" target="_blank" rel="noopener noreferrer nofollow" class="hidden md:inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-300" onclick="typeof gtag === 'function' && gtag('event', 'generate_lead', { event_category: 'whatsapp_contact', event_label: 'header_link' });">
          Contact B2B
        </a>
        <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg text-slate-300 hover:text-white transition-colors" aria-label="Ouvrir le menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </header>

    <main class="flex-grow relative z-10">

      {/* HERO */}
      <section class="max-w-5xl mx-auto px-6 pt-20 lg:pt-28 pb-16 text-center reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold tracking-wide uppercase mb-6">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-indigo-500"></span>
          </span>
          Programme partenaire B2B
        </div>
        <h1 class="text-4xl md:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight mb-6">
          Revendeur IPTV : panel, crédits et support pour <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-cyan-400 to-emerald-400">professionnels</span>
        </h1>
        <p class="text-lg text-slate-400 leading-relaxed max-w-2xl mx-auto mb-10">
          Démarrez ou développez votre activité de revente IPTV avec un fournisseur grossiste qui ne vend jamais aux particuliers. Panel B2B, crédits dégressifs, 7 serveurs élite, accompagnement technique inclus.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://wa.me/212782389820?text=Bonjour%2C%20je%20souhaite%20devenir%20revendeur%20IPTV" target="_blank" rel="noopener noreferrer nofollow" class="cta-pulse inline-flex items-center justify-center gap-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-bold py-4 px-8 rounded-xl transition-all duration-300 transform hover:-translate-y-0.5" onclick="typeof gtag === 'function' && gtag('event', 'generate_lead', { event_category: 'whatsapp_contact', event_label: 'content_cta' });">
            <WhatsAppIcon class="w-5 h-5" />
            Devenir Revendeur Maintenant
          </a>
          <a href="/tarifs-grossiste-iptv" class="inline-flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-slate-300 hover:text-white font-semibold py-4 px-8 rounded-xl transition-all duration-300">
            Voir les Tarifs
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </section>

      {/* SECTION 1 — Pour qui */}
      <section class="max-w-6xl mx-auto px-6 py-20 reveal">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4">À qui s'adresse notre <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">programme revendeur</span> ?</h2>
          <p class="text-slate-400 max-w-2xl mx-auto">Trois profils, un même objectif : construire une activité IPTV rentable et stable sans gérer l'infrastructure.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-[#0f1420] border border-white/5 hover:border-indigo-500/30 rounded-2xl p-7 transition-all">
            <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-5 text-2xl">🚀</div>
            <h3 class="text-lg font-bold mb-3">Le revendeur débutant</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-4">Vous lancez votre activité IPTV. Vous avez quelques prospects ou clients potentiels, mais aucune infrastructure. Nous vous fournissons un panel clé-en-main, un volume de démarrage de 10 crédits et un accompagnement pas-à-pas pour créer vos premiers comptes clients.</p>
            <p class="text-xs text-indigo-400 font-semibold">Idéal pour : 0–20 abonnés actifs</p>
          </div>
          <div class="bg-[#0f1420] border border-white/5 hover:border-emerald-500/30 rounded-2xl p-7 transition-all">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-5 text-2xl">📈</div>
            <h3 class="text-lg font-bold mb-3">Le revendeur existant</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-4">Vous gérez déjà une base de clients chez un autre fournisseur, mais l'uptime ne suit plus, le support est lent ou les marges fondent. Migrez vers nos serveurs sans interruption — nous prenons en charge le transfert technique et vous gardez vos clients.</p>
            <p class="text-xs text-emerald-400 font-semibold">Idéal pour : 50–500 abonnés actifs</p>
          </div>
          <div class="bg-[#0f1420] border border-white/5 hover:border-cyan-500/30 rounded-2xl p-7 transition-all">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center mb-5 text-2xl">🏢</div>
            <h3 class="text-lg font-bold mb-3">Les agences & gestionnaires multi-comptes</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-4">Vous opérez plusieurs marques de revente, gérez des centaines ou milliers d'abonnés, ou intégrez l'IPTV à une offre télécom plus large. Tarifs négociés sur volume, accès API, sous-revendeurs illimités.</p>
            <p class="text-xs text-cyan-400 font-semibold">Idéal pour : 500+ abonnés actifs</p>
          </div>
        </div>
      </section>

      {/* SECTION 2 — Ce que nous fournissons */}
      <section class="max-w-6xl mx-auto px-6 py-20 reveal">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4">Ce que nous fournissons à nos <span class="text-emerald-400">revendeurs partenaires</span></h2>
          <p class="text-slate-400 max-w-2xl mx-auto">Un écosystème complet pour gérer votre activité, de la création de comptes à la facturation.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-7">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-lg shrink-0">🖥️</div>
              <div>
                <h3 class="text-lg font-bold mb-2">Panel revendeur professionnel</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Interface Xtream UI complète pour créer, renouveler, suspendre et facturer vos abonnés en autonomie. Voir notre <a href="/panel-iptv" class="text-indigo-400 hover:text-indigo-300">guide panel IPTV</a>.</p>
              </div>
            </div>
          </div>
          <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-7">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-lg shrink-0">💳</div>
              <div>
                <h3 class="text-lg font-bold mb-2">Crédits en gros à tarif dégressif</h3>
                <p class="text-slate-400 text-sm leading-relaxed">1 crédit = 1 abonnement client de 12 mois. Plus vous achetez, moins le prix unitaire est élevé. <a href="/credits-iptv-en-gros" class="text-emerald-400 hover:text-emerald-300">Voir les paliers</a>.</p>
              </div>
            </div>
          </div>
          <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-7">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-lg shrink-0">🌐</div>
              <div>
                <h3 class="text-lg font-bold mb-2">7 serveurs élite au choix</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Lion OTT, Max OTT, Trex IPTV, Dream 4K, Magnum OTT, Pro Max, Dino IPTV. Chaque serveur a son positionnement. <a href="/comparatif-serveurs-iptv" class="text-cyan-400 hover:text-cyan-300">Comparer les serveurs</a>.</p>
              </div>
            </div>
          </div>
          <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-7">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-lg shrink-0">🤝</div>
              <div>
                <h3 class="text-lg font-bold mb-2">Accompagnement & support B2B</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Onboarding personnalisé, formation Xtream UI, groupe WhatsApp privé, réponse en moins de 15 minutes en heures ouvrées. <a href="/support-technique-iptv-revendeur" class="text-amber-400 hover:text-amber-300">Détails support</a>.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* SECTION 3 — Comment ça marche */}
      <section class="max-w-5xl mx-auto px-6 py-20 reveal">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4">Comment devenir revendeur en <span class="text-indigo-400">4 étapes</span></h2>
          <p class="text-slate-400 max-w-2xl mx-auto">Du premier contact à la création de votre premier abonné client, comptez en moyenne 24 heures.</p>
        </div>
        <div class="space-y-5">
          <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-6 flex items-start gap-5">
            <div class="w-10 h-10 rounded-full bg-indigo-600 flex items-center justify-center text-sm font-black shrink-0">1</div>
            <div>
              <h3 class="font-bold mb-1">Prise de contact WhatsApp</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Vous nous contactez via WhatsApp Business en précisant votre volume estimé (10, 50 ou 100+ crédits) et votre serveur souhaité. Nous évaluons ensemble votre marché cible et vous orientons vers le panel le plus adapté.</p>
            </div>
          </div>
          <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-6 flex items-start gap-5">
            <div class="w-10 h-10 rounded-full bg-emerald-600 flex items-center justify-center text-sm font-black shrink-0">2</div>
            <div>
              <h3 class="font-bold mb-1">Commande minimale & paiement</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Pour démarrer, nous demandons un minimum de 10 crédits (équivalent à 10 abonnements clients de 12 mois). Paiement par crypto, virement SEPA ou PayPal. Nous validons en moins de 2 heures en jours ouvrés.</p>
            </div>
          </div>
          <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-6 flex items-start gap-5">
            <div class="w-10 h-10 rounded-full bg-cyan-600 flex items-center justify-center text-sm font-black shrink-0">3</div>
            <div>
              <h3 class="font-bold mb-1">Activation panel & formation</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Vos identifiants panel revendeur vous sont envoyés. Un membre de l'équipe vous accompagne pendant 30 minutes en visio ou par messages pour configurer votre première ligne client et vous montrer les fonctionnalités essentielles.</p>
            </div>
          </div>
          <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-6 flex items-start gap-5">
            <div class="w-10 h-10 rounded-full bg-amber-600 flex items-center justify-center text-sm font-black shrink-0">4</div>
            <div>
              <h3 class="font-bold mb-1">Vous revendez en autonomie</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Vous fixez vos propres tarifs de revente, créez les comptes clients depuis votre panel et rechargez votre stock de crédits selon vos besoins. Notre équipe reste disponible 24/7 en cas de question technique.</p>
            </div>
          </div>
        </div>
      </section>

      {/* SECTION 4 — Bénéfices */}
      <section class="max-w-6xl mx-auto px-6 py-20 reveal">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4">Pourquoi nos partenaires <span class="text-emerald-400">restent</span></h2>
          <p class="text-slate-400 max-w-2xl mx-auto">Trois piliers concrets qui font la différence entre un grossiste sérieux et un fournisseur opportuniste.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-gradient-to-b from-indigo-950/40 to-[#0f1420] border border-indigo-500/20 rounded-2xl p-7">
            <div class="text-4xl font-black text-indigo-400 mb-2">100%</div>
            <h3 class="text-lg font-bold mb-2">Marge revendeur</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Vous fixez librement vos prix de revente. Nous ne touchons aucune commission sur vos ventes finales. La différence entre votre prix d'achat en gros et votre prix de revente client est intégralement votre marge.</p>
          </div>
          <div class="bg-gradient-to-b from-emerald-950/40 to-[#0f1420] border border-emerald-500/20 rounded-2xl p-7">
            <div class="text-4xl font-black text-emerald-400 mb-2">24/7</div>
            <h3 class="text-lg font-bold mb-2">Gestion autonome</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Votre panel est accessible 24h/24. Vous créez, renouvelez ou suspendez les comptes clients à tout moment, sans nous solliciter. Vos clients ignorent que nous existons : c'est votre marque qu'ils achètent.</p>
          </div>
          <div class="bg-gradient-to-b from-cyan-950/40 to-[#0f1420] border border-cyan-500/20 rounded-2xl p-7">
            <div class="text-4xl font-black text-cyan-400 mb-2">15 min</div>
            <h3 class="text-lg font-bold mb-2">Délai de support</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Temps de réponse moyen sur notre canal WhatsApp B2B en heures ouvrées. Aucun ticket fantôme, aucun bot. Un interlocuteur réel sur l'ensemble du cycle de votre activité revendeur.</p>
          </div>
        </div>
      </section>

      {/* SECTION 5 — FAQ Revendeur */}
      <section class="max-w-3xl mx-auto px-6 py-20 reveal">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-extrabold tracking-tight mb-4">FAQ Revendeur</h2>
          <p class="text-slate-400">Les questions les plus fréquentes avant de rejoindre notre programme.</p>
        </div>
        <div class="space-y-3">
          <div class="bg-[#0f1420] border border-white/5 hover:border-indigo-500/20 rounded-xl p-5 transition-all">
            <h3 class="text-sm font-bold text-white mb-2">Quel est le minimum de commande pour devenir revendeur ?</h3>
            <p class="text-slate-400 text-sm leading-relaxed">10 crédits minimum, soit 10 abonnements clients de 12 mois. Ce seuil garantit que nous travaillons uniquement avec des revendeurs sérieux et nous permet d'investir dans votre onboarding.</p>
          </div>
          <div class="bg-[#0f1420] border border-white/5 hover:border-indigo-500/20 rounded-xl p-5 transition-all">
            <h3 class="text-sm font-bold text-white mb-2">Faut-il une compétence technique pour démarrer ?</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Non. Le panel Xtream UI est volontairement simple : créer un client se fait en 30 secondes. Nous formons chaque nouveau revendeur lors de l'onboarding, et notre support est disponible si vous rencontrez un blocage.</p>
          </div>
          <div class="bg-[#0f1420] border border-white/5 hover:border-indigo-500/20 rounded-xl p-5 transition-all">
            <h3 class="text-sm font-bold text-white mb-2">Puis-je revendre sous ma propre marque ?</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Oui. Vos clients ne voient jamais notre nom. Vous pouvez configurer votre propre application, votre propre branding et votre propre tarification. Nous restons en coulisse en tant qu'opérateur d'infrastructure.</p>
          </div>
          <div class="bg-[#0f1420] border border-white/5 hover:border-indigo-500/20 rounded-xl p-5 transition-all">
            <h3 class="text-sm font-bold text-white mb-2">Êtes-vous concurrent de vos revendeurs ?</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Jamais. Nous ne vendons pas aux particuliers. Notre seul revenu provient des revendeurs B2B comme vous. Votre territoire client est protégé par construction.</p>
