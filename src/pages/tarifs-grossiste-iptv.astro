---
import SiteLayout from "../layouts/SiteLayout.astro";
import WhatsAppIcon from "../components/icons/WhatsAppIcon.astro";

const servers = [
  { name: "Lion OTT", badge: "Best-seller débutant", color: "indigo", t10: "130€", t50: "475€", t100: "900€", unit10: "13.00€", channels: "20K+", vod: "60K+", series: "15K+" },
  { name: "Max OTT", badge: "Référence premium", color: "cyan", t10: "140€", t50: "675€", t100: "1 250€", unit10: "14.00€", channels: "15K+", vod: "80K+", series: "20K+", recommended: true },
  { name: "Trex IPTV", badge: "Catalogue maximal", color: "amber", t10: "270€", t50: "1 075€", t100: "2 000€", unit10: "27.00€", channels: "22K+", vod: "90K+", series: "25K+" },
  { name: "Dream 4K", badge: "Ultra HD pur", color: "violet", t10: "180€", t50: "810€", t100: "1 500€", unit10: "18.00€", channels: "18K+", vod: "70K+", series: "18K+" },
  { name: "Magnum OTT", badge: "Stabilité élite", color: "emerald", t10: "165€", t50: "740€", t100: "1 380€", unit10: "16.50€", channels: "16K+", vod: "65K+", series: "16K+" },
  { name: "Pro Max", badge: "Volume élevé", color: "rose", t10: "200€", t50: "900€", t100: "1 700€", unit10: "20.00€", channels: "20K+", vod: "75K+", series: "20K+" },
  { name: "Dino IPTV", badge: "Polyvalent", color: "teal", t10: "120€", t50: "540€", t100: "1 020€", unit10: "12.00€", channels: "17K+", vod: "55K+", series: "14K+" },
];

const colorMap: Record<string, { bg: string; border: string; text: string; gradientFrom: string }> = {
  indigo:  { bg: "bg-indigo-500/10",  border: "border-indigo-500/20",  text: "text-indigo-400",  gradientFrom: "from-indigo-500/20" },
  cyan:    { bg: "bg-cyan-500/10",    border: "border-cyan-500/20",    text: "text-cyan-400",    gradientFrom: "from-cyan-500/20" },
  amber:   { bg: "bg-amber-500/10",   border: "border-amber-500/20",   text: "text-amber-400",   gradientFrom: "from-amber-500/20" },
  violet:  { bg: "bg-violet-500/10",  border: "border-violet-500/20",  text: "text-violet-400",  gradientFrom: "from-violet-500/20" },
  emerald: { bg: "bg-emerald-500/10", border: "border-emerald-500/20", text: "text-emerald-400", gradientFrom: "from-emerald-500/20" },
  rose:    { bg: "bg-rose-500/10",    border: "border-rose-500/20",    text: "text-rose-400",    gradientFrom: "from-rose-500/20" },
  teal:    { bg: "bg-teal-500/10",    border: "border-teal-500/20",    text: "text-teal-400",    gradientFrom: "from-teal-500/20" },
};
---

<SiteLayout
  title="Tarifs Grossiste IPTV : Prix Crédits Revendeur en Gros 2026"
  description="Tarifs revendeur IPTV en gros : grille de prix par serveur, paliers 10/50/100+ crédits, tarifs dégressifs. Lion OTT, Max OTT, Trex IPTV, Dream 4K. Devis personnalisé."
  canonical="https://grossisteiptv.com/tarifs-grossiste-iptv/"
  active="tarifs"
>

  {/* ── Hero ── */}
  <section class="max-w-5xl mx-auto px-6 pt-20 lg:pt-28 pb-12 text-center reveal">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold tracking-wide uppercase mb-6">Tarifs Revendeur 2026</div>
    <h1 class="text-4xl md:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight mb-6">
      Tarifs Grossiste IPTV — <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-emerald-400">Prix Revendeur en Gros</span>
    </h1>
    <p class="text-lg text-slate-400 leading-relaxed max-w-2xl mx-auto">
      Grille tarifaire complète par serveur et par palier de volume. Tous les prix s'entendent pour des crédits unitaires (1 crédit = 1 abonnement client de 12 mois).
    </p>
  </section>

  {/* ── Pricing Factors ── */}
  <section class="max-w-5xl mx-auto px-6 py-12 reveal">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3">Trois facteurs qui impactent votre prix</h2>
      <p class="text-slate-400 max-w-xl mx-auto text-sm">La tarification revendeur n'est jamais figée — elle s'adapte à votre profil et à votre volume.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-lg mb-4">📦</div>
        <h3 class="font-bold mb-2">Volume commandé</h3>
        <p class="text-slate-400 text-sm leading-relaxed">Plus vous achetez de crédits en une fois, plus le prix unitaire baisse. Les paliers principaux sont 10, 50 et 100+. Au-delà de 200 crédits, des tarifs négociés s'appliquent.</p>
      </div>
      <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-lg mb-4">🌐</div>
        <h3 class="font-bold mb-2">Serveur choisi</h3>
        <p class="text-slate-400 text-sm leading-relaxed">Chaque serveur a un coût d'infrastructure spécifique. Lion OTT démarre le plus bas, Trex IPTV est le plus cher mais offre le catalogue le plus vaste. <a href="/comparatif-serveurs-iptv" class="text-emerald-400 hover:text-emerald-300">Comparer</a>.</p>
      </div>
      <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-lg mb-4">⏱️</div>
        <h3 class="font-bold mb-2">Durée d'abonnement</h3>
        <p class="text-slate-400 text-sm leading-relaxed">Nos tarifs standard correspondent à des abonnements clients de 12 mois. Des durées 3, 6 mois sont possibles avec un coefficient adapté (consultez-nous).</p>
      </div>
    </div>
  </section>

  {/* ── 2-Column Grid: Server Cards + Volume Tiers ── */}
  <section class="max-w-7xl mx-auto px-6 py-12 reveal">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3">Grille tarifaire par serveur</h2>
      <p class="text-slate-400 max-w-2xl mx-auto text-sm">Prix indicatifs hors taxes. Devis personnalisé sur demande pour les volumes 200+.</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">

      {/* ── Left Column: Server Pricing Cards ── */}
      <div class="space-y-4">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Tarifs par serveur</h3>
        {servers.map((s) => {
          const c = colorMap[s.color];
          return (
            <div class={`relative bg-[#0f1420] border rounded-2xl p-6 transition-all hover:border-white/15 ${s.recommended ? `border-indigo-500/30` : 'border-white/5'}`}>
              {s.recommended && (
                <div class="absolute -top-3 left-6 bg-indigo-500 text-white text-[10px] font-bold px-3 py-1 rounded-full tracking-wider uppercase">Recommandé</div>
              )}
              <div class="flex items-start justify-between mb-4">
                <div>
                  <h4 class={`text-lg font-bold ${c.text}`}>{s.name}</h4>
                  <span class="text-[11px] text-slate-500">{s.badge}</span>
                </div>
                <div class="text-right">
                  <div class="text-xs text-slate-500">à partir de</div>
                  <div class={`text-xl font-extrabold ${c.text}`}>{s.unit10}<span class="text-xs text-slate-500 font-normal">/crédit</span></div>
                </div>
              </div>
              <div class="grid grid-cols-3 gap-3 mb-4">
                <div class="bg-white/[0.03] rounded-xl p-3 text-center">
                  <div class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">10 crédits</div>
                  <div class="text-sm font-bold text-slate-300">{s.t10}</div>
                </div>
                <div class="bg-white/[0.03] rounded-xl p-3 text-center">
                  <div class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">50 crédits</div>
                  <div class="text-sm font-bold text-slate-300">{s.t50}</div>
                </div>
                <div class="bg-white/[0.03] rounded-xl p-3 text-center">
                  <div class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">100 crédits</div>
                  <div class="text-sm font-bold text-emerald-400">{s.t100}</div>
                </div>
              </div>
              <div class="flex items-center gap-4 text-xs text-slate-400">
                <span>📡 {s.channels} chaînes</span>
                <span>🎬 {s.vod} VOD</span>
                <span>📺 {s.series} séries</span>
              </div>
            </div>
          );
        })}
        <p class="text-xs text-slate-500 text-center mt-2">Prix indicatifs susceptibles d'évolution. Confirmation du tarif au moment du devis WhatsApp.</p>
      </div>

      {/* ── Right Column: Volume Tiers + Table + CTA ── */}
      <div class="space-y-6">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Paliers de volume</h3>

        {/* Tier: Démarrage */}
        <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-7">
          <span class="inline-block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-2">Démarrage</span>
          <div class="text-3xl font-black mb-1">10 crédits</div>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">Idéal pour démarrer une activité revendeur. Vous testez le marché avec un risque limité.</p>
          <ul class="space-y-1.5 text-xs text-slate-300">
            <li>• Panel revendeur activé</li>
            <li>• Onboarding personnalisé</li>
            <li>• Support B2B inclus</li>
          </ul>
        </div>

        {/* Tier: Croissance (recommended) */}
        <div class="relative bg-gradient-to-b from-indigo-950/40 to-[#0f1420] border border-indigo-500/30 rounded-2xl p-7">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-500 text-white text-[10px] font-bold px-3 py-1 rounded-full tracking-wider uppercase">Le plus rentable</div>
          <span class="inline-block text-[10px] font-bold text-indigo-400 uppercase tracking-wider mb-2">Croissance</span>
          <div class="text-3xl font-black mb-1">50 crédits</div>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">Le sweet spot. Tarif unitaire fortement réduit, marge optimale pour les revendeurs en croissance.</p>
          <ul class="space-y-1.5 text-xs text-slate-300">
            <li>• Tarif dégressif palier 2</li>
            <li>• Codes test illimités</li>
            <li>• Priorité support</li>
          </ul>
        </div>

        {/* Tier: Volume */}
        <div class="bg-[#0f1420] border border-white/5 rounded-2xl p-7">
          <span class="inline-block text-[10px] font-bold text-emerald-400 uppercase tracking-wider mb-2">Volume</span>
          <div class="text-3xl font-black mb-1">100+ crédits</div>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">Pour les revendeurs établis et agences. Tarifs négociés, sous-revendeurs autorisés.</p>
          <ul class="space-y-1.5 text-xs text-slate-300">
            <li>• Tarif dégressif palier 3</li>
            <li>• Sous-revendeurs activés</li>
            <li>• Account manager dédié</li>
          </ul>
        </div>

        {/* Comparison Table Summary */}
        <div class="bg-[#0f1420] border border-white/5 rounded-2xl overflow-hidden">
          <div class="px-6 py-4 border-b border-white/5">
            <h3 class="font-bold text-sm">Comparatif rapide</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead class="bg-white/5">
                <tr>
                  <th class="text-left px-4 py-3 font-bold text-slate-300">Serveur</th>
                  <th class="text-center px-4 py-3 font-bold text-slate-300">10 cr.</th>
                  <th class="text-center px-4 py-3 font-bold text-slate-300">50 cr.</th>
                  <th class="text-center px-4 py-3 font-bold text-slate-300">100 cr.</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                {servers.map((s) => (
                  <tr class="hover:bg-white/[0.02] transition-colors">
                    <td class="px-4 py-2.5 font-bold text-white">{s.name}</td>
                    <td class="px-4 py-2.5 text-center text-slate-300">{s.t10}</td>
                    <td class="px-4 py-2.5 text-center text-slate-300">{s.t50}</td>
                    <td class="px-4 py-2.5 text-center font-bold text-emerald-400">{s.t100}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* CTA */}
        <div class="bg-gradient-to-br from-emerald-900/30 to-cyan-900/20 border border-emerald-500/20 rounded-3xl p-8 text-center">
          <h2 class="text-xl md:text-2xl font-bold mb-3">Demander un tarif personnalisé</h2>
          <p class="text-slate-400 text-sm mb-6 max-w-md mx-auto">Précisez votre volume et votre serveur souhaité — devis sous 2 heures en jours ouvrés.</p>
          <a href="https://wa.me/212782389820?text=Bonjour%2C%20je%20veux%20un%20devis%20personnalis%C3%A9%20revendeur%20IPTV" target="_blank" rel="noopener noreferrer nofollow" class="inline-flex items-center gap-3 bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-bold px-8 py-4 rounded-xl transition-all duration-300 transform hover:-translate-y-0.5" onclick="typeof gtag === 'function' && gtag('event', 'generate_lead', { event_category: 'whatsapp_contact', event_label: 'content_cta' });">
            <WhatsAppIcon class="w-5 h-5" />
            Demander mon Devis
          </a>
        </div>
      </div>

    </div>
  </section>

  {/* ── Bottom links ── */}
  <section class="max-w-4xl mx-auto px-6 pb-16 reveal">
    <p class="text-slate-400 text-sm leading-relaxed text-center">
      Pour comprendre comment fonctionnent les <a href="/credits-iptv-en-gros" class="text-slate-300 hover:text-indigo-400 underline underline-offset-2">crédits IPTV en gros</a>, démarrer comme <a href="/revendeur-iptv" class="text-slate-300 hover:text-indigo-400 underline underline-offset-2">revendeur partenaire</a> ou explorer notre <a href="/serveurs" class="text-slate-300 hover:text-indigo-400 underline underline-offset-2">catalogue de 7 serveurs</a>.
    </p>
  </section>

</SiteLayout>
